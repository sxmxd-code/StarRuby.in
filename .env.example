# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudflare R2 Configuration (Zero-Egress Object Storage)
VITE_CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
VITE_CLOUDFLARE_R2_BUCKET_NAME=documents
VITE_CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
VITE_CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
VITE_CLOUDFLARE_R2_PUBLIC_DOMAIN=

# Google Gemini AI Configuration (Gemini 2.5 Flash & Embeddings)
VITE_GEMINI_API_KEY=your-gemini-api-key

# App Environment
VITE_APP_ENV=development
